/// Risks and opportunities register feeding the outlook scenarios.
table FactRiskOpp

	column ItemID
		dataType: string
		summarizeBy: none
		sourceColumn: ItemID

	column ItemType
		dataType: string
		summarizeBy: none
		sourceColumn: ItemType

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column Description
		dataType: string
		summarizeBy: none
		sourceColumn: Description

	column ProjectKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ProjectKey

	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: CustomerKey

	column ExpectedDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: ExpectedDate

	column RevenueImpact
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: RevenueImpact

	column Probability
		dataType: double
		isHidden
		formatString: 0%
		summarizeBy: none
		sourceColumn: Probability

	column Owner
		dataType: string
		summarizeBy: none
		sourceColumn: Owner

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: Status

	partition FactRiskOpp = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(DataFolder & "pharma_project_finance.xlsx"), null, true),
					Data = Source{[Item = "FactRiskOpp", Kind = "Table"]}[Data],
					Typed = Table.TransformColumnTypes(Data, {{"ItemID", type text}, {"ItemType", type text}, {"Category", type text}, {"Description", type text}, {"ProjectKey", Int64.Type}, {"CustomerKey", Int64.Type}, {"ExpectedDate", type date}, {"RevenueImpact", type number}, {"Probability", type number}, {"Owner", type text}, {"Status", type text}})
				in
					Typed

	annotation PBI_ResultType = Table
