/// Calendar table built in DAX from the fact-table date range. Marked as the model's date table.
table DimDate
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column Quarter
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

	column Month
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

	column 'Year Month'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

	/// "Actual" up to the reporting close date (last closed month), "Forecast" after it.
	column 'Period Type'
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period Type]

	hierarchy Calendar

		level Year
			column: Year

		level Quarter
			column: Quarter

		level Month
			column: Month

	partition DimDate = calculated
		mode: import
		source =
				VAR _start = DATE ( YEAR ( MIN ( FactCost[PostingDate] ) ), 1, 1 )
				VAR _end = DATE ( YEAR ( MAX ( FactRevenuePlan[PeriodEnd] ) ), 12, 31 )
				VAR _close = MAX ( FactLedger[PeriodEnd] )
				RETURN
					ADDCOLUMNS (
						CALENDAR ( _start, _end ),
						"Year", YEAR ( [Date] ),
						"Quarter", "Q" & QUARTER ( [Date] ),
						"Month Number", MONTH ( [Date] ),
						"Month", FORMAT ( [Date], "mmm" ),
						"Year Month", FORMAT ( [Date], "yyyy-mm" ),
						"Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
						"Period Type", IF ( [Date] <= _close, "Actual", "Forecast" )
					)
