/// Actual cost by month-end and WBS element.
table FactCost
	lineageTag: f291e2cf-a88b-4023-87b6-f03e8978e285

	column PostingDate
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: fb4907b4-5b5a-4fc4-b7d1-d7ae5ce90237
		summarizeBy: none
		sourceColumn: PostingDate

		annotation UnderlyingDateTimeDataType = Date

	column ProjectKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2587a49b-79d6-4771-a17c-b5c06e1cb6d6
		summarizeBy: none
		sourceColumn: ProjectKey

	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cbcf4047-3880-4bfb-9d3c-3e565ad1ab61
		summarizeBy: none
		sourceColumn: CustomerKey

	column WBSKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 21a3b283-d953-46af-8e18-0752d8b6c1d9
		summarizeBy: none
		sourceColumn: WBSKey

	column ActualCost
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: 06b343bc-04cb-44c9-b738-e463924a1b4a
		summarizeBy: none
		sourceColumn: ActualCost

	partition FactCost = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(DataFolder & "pharma_project_finance.xlsx"), null, true),
					Data = Source{[Item = "FactCost", Kind = "Table"]}[Data],
					Typed = Table.TransformColumnTypes(Data, {{"PostingDate", type date}, {"ProjectKey", Int64.Type}, {"CustomerKey", Int64.Type}, {"WBSKey", Int64.Type}, {"ActualCost", type number}})
				in
					Typed

	annotation PBI_ResultType = Table

