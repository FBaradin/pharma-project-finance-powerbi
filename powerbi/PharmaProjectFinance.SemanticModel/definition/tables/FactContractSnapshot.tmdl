/// Month-end controlling snapshot of over-time projects: transaction price (incl. approved change orders) and estimate at completion (EAC).
table FactContractSnapshot

	column SnapshotDate
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: SnapshotDate

	column ProjectKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ProjectKey

	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: CustomerKey

	column TransactionPrice
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: TransactionPrice

	column EstimateAtCompletion
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: EstimateAtCompletion

	partition FactContractSnapshot = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(DataFolder & "pharma_project_finance.xlsx"), null, true),
					Data = Source{[Item = "FactContractSnapshot", Kind = "Table"]}[Data],
					Typed = Table.TransformColumnTypes(Data, {{"SnapshotDate", type date}, {"ProjectKey", Int64.Type}, {"CustomerKey", Int64.Type}, {"TransactionPrice", type number}, {"EstimateAtCompletion", type number}})
				in
					Typed

	annotation PBI_ResultType = Table
