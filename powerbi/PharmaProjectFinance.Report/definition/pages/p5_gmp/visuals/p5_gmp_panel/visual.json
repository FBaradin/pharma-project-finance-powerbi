                      "color": "#1F3A5F",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• B-304 failed in May (3 deviations): 250k lost and a remake (B-312) is planned for December.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
