                    "value": "Failed batch → no revenue and its cost is absorbed",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1F2937",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Clinical batches (PRJ-102) are tracked for quality, but their revenue comes from % complete (page 1).",
